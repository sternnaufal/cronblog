# ============================================================
# CRONBLOG - Environment Configuration
# Copy this file to .env and fill in your credentials
# ============================================================

# --- AI Provider (pick at least one) ---

# Google Gemini API (recommended)
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API (fallback option)
# Get your API key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# --- Blogger API ---
# Option A: OAuth 2.0 (recommended for local dev)
# Get OAuth 2.0 credentials from Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# 1. Create a new OAuth 2.0 Client ID (Desktop application)
# 2. Download JSON, rename to client_secret.json
# 3. Place in project root folder
#
# Option B: Service Account (for GitHub Actions / headless)
# 1. Create a service account in Google Cloud Console
# 2. Download JSON key, place in project root
# 3. Set GOOGLE_APPLICATION_CREDENTIALS or let auto-detect
# 4. Share your blog with the service account email

BLOGGER_BLOG_ID=your_blog_id_here
# To find your Blog ID: Settings > Info > Blog ID in Blogger dashboard

# Optional: Explicit path to service account JSON
# GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# --- RSS Feed Sources (comma-separated) ---
# Default tech/trending feeds (optional - can be left as-is)
RSS_FEEDS=https://news.google.com/rss,https://feeds.feedburner.com/blogspot/gJZg

# --- Schedule ---
# CRON schedule expression (default: twice weekly, Mon & Thu at 8am)
CRON_SCHEDULE=0 8 * * 1,4

# --- LLM Model Selection ---
# Google Gemini model (default: gemini-2.5-flash)
# Options: gemini-2.5-flash, gemini-2.5-pro, gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-2.5-flash

# Max articles to generate per run
MAX_ARTICLES_PER_RUN=1
