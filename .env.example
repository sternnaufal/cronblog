# ============================================================
# CRONBLOG - Environment Configuration
# Copy this file to .env and fill in your credentials
# ============================================================

# --- AI Provider (PRIMARY: Custom Local API) ---

# Custom OpenAI-compatible API endpoint (recommended - no rate limits!)
# Supports any local/self-hosted API: Ollama, vLLM, LocalAI, 9router, etc.
# Default: http://localhost:20128/v1 (9router)
CUSTOM_API_BASE_URL=http://localhost:20128/v1
CUSTOM_API_KEY=not-needed
CUSTOM_MODEL=combo1

# Google Gemini API (cloud fallback if local API is down)
# Get your API key at: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API (secondary fallback)
# Get your API key at: https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# --- Blogger API ---
# Option A: OAuth 2.0 (recommended for local dev)
# Get OAuth 2.0 credentials from Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# 1. Create a new OAuth 2.0 Client ID (Desktop application)
# 2. Download JSON, rename to client_secret.json
# 3. Place in project root folder
#
# Option B: Service Account (for GitHub Actions / headless)
# 1. Create a service account in Google Cloud Console
# 2. Download JSON key, place in project root
# 3. Set GOOGLE_APPLICATION_CREDENTIALS or let auto-detect
# 4. Share your blog with the service account email

BLOGGER_BLOG_ID=your_blog_id_here
# To find your Blog ID: Settings > Info > Blog ID in Blogger dashboard

# Optional: Explicit path to service account JSON
# GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# --- RSS Feed Sources (comma-separated) ---
# Default tech/trending feeds (optional - can be left as-is)
RSS_FEEDS=https://news.google.com/rss,https://feeds.feedburner.com/blogspot/gJZg

# --- Schedule ---
# CRON schedule expression (default: twice weekly, Mon & Thu at 8am)
CRON_SCHEDULE=0 8 * * 1,4

# --- LLM Model Selection ---
# Google Gemini model (fallback, only used if local API fails)
# GEMINI_MODEL=gemini-2.5-flash

# Max articles to generate per run
MAX_ARTICLES_PER_RUN=1

# --- Publish Mode ---
# draft     = simpan sebagai draft (default), review manual di blogger.com
# live      = publish langsung ke blog
# scheduled = publish otomatis setelah PUBLISH_DELAY_HOURS jam
PUBLISH_MODE=draft
PUBLISH_DELAY_HOURS=6    # hanya berlaku kalo mode = scheduled

# --- Image Settings ---
# Auto-add relevant images to articles (uses picsum.photos - free, no key)
# Set IMAGE_ENABLED=false to disable
IMAGE_ENABLED=true
IMAGE_PROVIDER=picsum    # picsum (free) or pexels (need API key below)
IMAGE_WIDTH=800
IMAGE_HEIGHT=400

# Optional: Pexels API key for better quality images
# Get a free key at https://www.pexels.com/api/
# PEXELS_API_KEY=your_pexels_api_key_here

# --- Social Share (auto share after publish) ---
# Telegram (recommended - easy & free)
# 1. Chat @BotFather di Telegram, buat bot baru, dapetin token
# 2. Chat @userinfobot, dapetin chat ID kamu
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234
# TELEGRAM_CHAT_ID=123456789

# Twitter/X (butuh Twitter Developer Account + OAuth 1.0a)
# TWITTER_API_KEY=your_api_key
# TWITTER_API_SECRET=your_api_secret
# TWITTER_ACCESS_TOKEN=your_access_token
# TWITTER_ACCESS_SECRET=your_access_secret
